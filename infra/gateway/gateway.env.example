# Biến cho các script infra/gateway/*.sh (Day 60)
#   cp gateway.env.example gateway.env   → sửa nếu cần. gateway.env nằm trong .gitignore (KHÔNG commit).
# ACCOUNT_ID không cần điền: script tự lấy bằng `aws sts get-caller-identity`.

AWS_REGION=us-east-1
ORDERS_TABLE=support-orders

# Lambda chứa tool get_order (lambdas/get_order/handler.py) + role riêng của nó
LAMBDA_NAME=support-get-order
LAMBDA_ROLE=support-get-order-lambda

# Gateway (MCP server) + service role của nó + tên target (thành tiền tố tên tool: orders___get_order)
GATEWAY_NAME=support-gateway
GATEWAY_ROLE=support-gateway
TARGET_NAME=orders

# Số ngày giữ log CloudWatch của Lambda
LOG_RETENTION_DAYS=14

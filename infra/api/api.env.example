# Biến cho các script infra/api/*.sh (Day 64 — web: HTTP API + Bridge Lambda)
#   cp api.env.example api.env   → sửa nếu cần. api.env nằm trong .gitignore (KHÔNG commit).
# Id (Runtime, pool, client, API) KHÔNG lưu ở đây: script tra theo tên mỗi lần chạy.

AWS_REGION=us-east-1
# Runtime mà Bridge được gọi (infra/runtime) — Bridge chỉ có quyền InvokeAgentRuntime trên đúng nó
RUNTIME_NAME=support_agent
# Cognito (infra/auth) — JWT authorizer kiểm token do pool / client này cấp
POOL_NAME=support-users
CLIENT_NAME=support-web

BRIDGE_NAME=support-chat-bridge
BRIDGE_ROLE=support-chat-bridge
API_NAME=support-chat-api
# Origin duy nhất được gọi từ trình duyệt (Vite dev server). Có domain thật → đổi ở đây
ALLOWED_ORIGIN=http://localhost:5173
# Throttle toàn API (cộng chung mọi người dùng): req/giây + burst — chặn đốt token Bedrock
THROTTLE_RATE=5
THROTTLE_BURST=10
LOG_RETENTION_DAYS=14

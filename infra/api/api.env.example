# Biến cho infra/api/03-frontend-env.sh (Day 64 — web)
#   cp api.env.example api.env   → sửa nếu cần. api.env nằm trong .gitignore (KHÔNG commit).
# Id (pool, client, API) KHÔNG lưu ở đây: script tra theo tên mỗi lần chạy.
# Bridge, HTTP API, CORS, throttle: infra/terraform/live/terraform.tfvars (Day 65).

AWS_REGION=us-east-1
POOL_NAME=support-users
CLIENT_NAME=support-web
API_NAME=support-chat-api
# Chỉ để nhắc khi in hướng dẫn — giá trị thật CORS dùng là allowed_origin trong terraform.tfvars
ALLOWED_ORIGIN=http://localhost:5173

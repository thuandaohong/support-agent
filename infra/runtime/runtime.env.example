# Biến cho các script infra/runtime/*.sh
#   cp runtime.env.example runtime.env   → điền giá trị. runtime.env nằm trong .gitignore (KHÔNG commit).
# ACCOUNT_ID không cần điền: script tự lấy bằng `aws sts get-caller-identity`.

AWS_REGION=us-east-1
# Knowledge Base chính sách (aws bedrock-agent list-knowledge-bases)
KB_ID=
ORDERS_TABLE=support-orders
# Model router + writer — permissions chỉ cho đúng model này
MODEL_ID=amazon.nova-lite-v1:0

# Đường tra đơn (Day 60): direct = boto3 → DynamoDB · gateway = AgentCore Gateway → Lambda
#   gateway: URL + id tra theo GATEWAY_NAME (infra/gateway), không lưu vào file
ORDER_BACKEND=gateway
GATEWAY_NAME=support-gateway

ECR_REPO=support-agent
# git SHA của image đã push lên ECR (Day 58: 2fe1122)
IMAGE_TAG=

ROLE_NAME=support-agent-runtime
# Tên Runtime: chỉ chữ, số, "_" — KHÔNG có "-"
RUNTIME_NAME=support_agent
# "Hôm nay" cho luật đổi trả. Runtime demo/eval: 2026-11-08 (khớp dữ liệu mẫu). Production: để trống = ngày thật
AS_OF_DATE=2026-11-08
# Session rảnh bao lâu thì tắt (giây, 60–28800) · sống tối đa bao lâu (giây)
IDLE_TIMEOUT=300
MAX_LIFETIME=1800
# Số ngày giữ log CloudWatch (07-log-retention.sh)
LOG_RETENTION_DAYS=14

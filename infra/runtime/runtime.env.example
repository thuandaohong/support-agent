# Biến cho các script infra/runtime/*.sh (invoke, logs, stop session) + infra/iam-audit.sh
#   cp runtime.env.example runtime.env   → sửa nếu cần. runtime.env nằm trong .gitignore (KHÔNG commit).
# Cấu hình Runtime (image, model, lifecycle, AS_OF_DATE…) nằm trong infra/terraform/live/terraform.tfvars (Day 65).

AWS_REGION=us-east-1
# Tên Runtime: chỉ chữ, số, "_" — KHÔNG có "-"
RUNTIME_NAME=support_agent
# iam-audit.sh: role + model cần kiểm
ROLE_NAME=support-agent-runtime
MODEL_ID=amazon.nova-lite-v1:0

# Biến cho infra/auth/03-test-users.sh + auth/cognito.py (Day 63 — Cognito cho NGƯỜI DÙNG)
#   cp auth.env.example auth.env   → sửa nếu cần. auth.env nằm trong .gitignore (KHÔNG commit).
# Pool id / client id KHÔNG lưu ở đây: script tra theo tên mỗi lần chạy.
# Mật khẩu user test do 03-test-users.sh sinh, ghi vào test-users.env (gitignore, chmod 600).

AWS_REGION=us-east-1
POOL_NAME=support-users
# App client cho web (Day 64: SPA React) — public, KHÔNG secret
CLIENT_NAME=support-web
# User test = các khách có trong eval/*.jsonl (username = customer_id — giới hạn bài học, xem README)
TEST_USERS="C003 C007 C008 C014 C019 C020 C026 C044"

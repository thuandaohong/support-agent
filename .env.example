# Copy thành .env rồi điền giá trị (.env đã nằm trong .gitignore — không commit)
AWS_REGION=us-east-1
POLICY_KB_ID=

# Day 6 — bảng đơn hàng DynamoDB
ORDERS_TABLE=support-orders

# Day 7 — model định tuyến (rẻ, temperature 0)
ROUTER_MODEL_ID=amazon.nova-lite-v1:0
# "Hôm nay" cho tính hạn đổi trả/bảo hành — eval cố định để kết quả lặp lại được
AS_OF_DATE=2026-11-08
# Day 8 — model viết câu trả lời (có thể khác router)
WRITER_MODEL_ID=amazon.nova-lite-v1:0
